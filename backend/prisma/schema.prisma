generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id        String   @id @default(cuid())
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("examples")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  resource  String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum WaitlistSource {
  join_club
  newsletter
  booking
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  name      String         @default("")
  email     String         @unique
  phone     String?
  source    WaitlistSource
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([email])
  @@map("waitlist_entries")
}

enum UserRole {
  student
  admin
}

/// Better Auth user (+ product role). Table kept as `users` for booking FKs.
model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  role          UserRole      @default(student)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  wallet              Wallet?
  walletTopUps        WalletTopUp[]
  walletLedgerEntries WalletLedgerEntry[]
  foodOrders          FoodOrder[]

  @@unique([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

enum BookingPlan {
  court
  open_play
  clinic
}

enum BookingStatus {
  pending
  approved
  rejected
}

model Booking {
  id                 String        @id @default(cuid())
  plan               BookingPlan
  date               String
  /** Primary / first court — kept for indexes and Open Play placeholder. */
  courtId            String        @map("court_id")
  /** Union of hours (Open Play session ids, or all court-hour ids). */
  slotIds            String[]      @map("slot_ids")
  /** Court plan segments: [{ courtId, slotIds }]. Null/legacy rows use courtId+slotIds. */
  courtSlots         Json?         @map("court_slots")
  name               String
  email              String
  userId             String?       @map("user_id")
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  referenceId        String        @default("") @map("reference_id")
  receiptName        String?       @map("receipt_name")
  receiptKey         String?       @map("receipt_key")
  receiptMimeType    String?       @map("receipt_mime_type")
  walletAppliedCents Int           @default(0) @map("wallet_applied_cents")
  status             BookingStatus @default(pending)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([date, courtId])
  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("bookings")
}

enum OpenPlaySessionStatus {
  upcoming
  live
  completed
  cancelled
}

enum OpenPlayParticipantStatus {
  booked
  checked_in
  no_show
  left_session
}

enum OpenPlayCourtState {
  available
  ready
  playing
  game_over
  unavailable
}

enum OpenPlayGameStatus {
  playing
  completed
}

/** Live Open Play session for one facility date + Open Play session band. */
model OpenPlaySession {
  id           String                @id @default(cuid())
  date         String
  slotId       String                @map("slot_id")
  status       OpenPlaySessionStatus @default(upcoming)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  participants OpenPlayParticipant[]
  courts       OpenPlayCourt[]
  games        OpenPlayGame[]
  queue        OpenPlayQueueEntry[]

  @@unique([date, slotId])
  @@index([status])
  @@map("open_play_sessions")
}

/** One approved Open Play booking seat inside a live session. */
model OpenPlayParticipant {
  id           String                    @id @default(cuid())
  sessionId    String                    @map("session_id")
  session      OpenPlaySession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bookingId    String                    @map("booking_id")
  userId       String?                   @map("user_id")
  name         String
  email        String
  status       OpenPlayParticipantStatus @default(booked)
  checkedInAt  DateTime?                 @map("checked_in_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  seats        OpenPlayGameSeat[]
  queueEntries OpenPlayQueueEntry[]

  @@unique([sessionId, bookingId])
  @@index([sessionId, status])
  @@index([userId])
  @@map("open_play_participants")
}

model OpenPlayCourt {
  id         String             @id @default(cuid())
  sessionId  String             @map("session_id")
  session    OpenPlaySession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courtId    String             @map("court_id")
  courtLabel String             @map("court_label")
  state      OpenPlayCourtState @default(available)
  updatedAt  DateTime           @updatedAt @map("updated_at")
  games      OpenPlayGame[]

  @@unique([sessionId, courtId])
  @@map("open_play_courts")
}

model OpenPlayGame {
  id            String             @id @default(cuid())
  sessionId     String             @map("session_id")
  session       OpenPlaySession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courtRowId    String             @map("court_row_id")
  court         OpenPlayCourt      @relation(fields: [courtRowId], references: [id], onDelete: Cascade)
  status        OpenPlayGameStatus @default(playing)
  startedAt     DateTime           @default(now()) @map("started_at")
  endedAt       DateTime?          @map("ended_at")
  endedByUserId String?            @map("ended_by_user_id")
  /** "player" | "staff" — who ended the game. */
  endedByRole   String?            @map("ended_by_role")
  createdAt     DateTime           @default(now()) @map("created_at")
  seats         OpenPlayGameSeat[]

  @@index([sessionId, status])
  @@index([courtRowId, status])
  @@map("open_play_games")
}

model OpenPlayGameSeat {
  id            String              @id @default(cuid())
  gameId        String              @map("game_id")
  game          OpenPlayGame        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participantId String              @map("participant_id")
  participant   OpenPlayParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /** "A" | "B" — seats 0-1 are side A, seats 2-3 are side B. */
  side          String
  seatIndex     Int                 @map("seat_index")

  @@unique([gameId, seatIndex])
  @@index([participantId])
  @@map("open_play_game_seats")
}

model OpenPlayQueueEntry {
  id            String              @id @default(cuid())
  sessionId     String              @map("session_id")
  session       OpenPlaySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String              @map("participant_id")
  participant   OpenPlayParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  position      Int

  @@unique([sessionId, participantId])
  @@index([sessionId, position])
  @@map("open_play_queue_entries")
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0) @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

enum WalletLedgerType {
  top_up
  booking_debit
  booking_refund
  food_debit
}

model WalletLedgerEntry {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents       Int              @map("amount_cents")
  balanceAfterCents Int              @map("balance_after_cents")
  type              WalletLedgerType
  referenceType     String?          @map("reference_type")
  referenceId       String?          @map("reference_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId, type])
  @@map("wallet_ledger_entries")
}

enum WalletTopUpStatus {
  pending
  approved
  rejected
}

model WalletTopUp {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int               @map("amount_cents")
  receiptName     String?           @map("receipt_name")
  receiptKey      String?           @map("receipt_key")
  receiptMimeType String?           @map("receipt_mime_type")
  status          WalletTopUpStatus @default(pending)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("wallet_top_ups")
}

enum FoodOrderStatus {
  pending
  preparing
  ready
}

enum FoodPayMode {
  wallet
  counter
}

model FoodMenuItem {
  id             String   @id @default(cuid())
  name           String
  priceCents     Int      @map("price_cents")
  category       String?
  available      Boolean  @default(true)
  imageKey       String?  @map("image_key")
  imageMimeType  String?  @map("image_mime_type")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([available])
  @@map("food_menu_items")
}

model FoodOrder {
  id         String          @id @default(cuid())
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     FoodOrderStatus @default(pending)
  payMode    FoodPayMode     @map("pay_mode")
  totalCents Int             @map("total_cents")
  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  lines      FoodOrderLine[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("food_orders")
}

model FoodOrderLine {
  id             String    @id @default(cuid())
  orderId        String    @map("order_id")
  order          FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?   @map("menu_item_id")
  name           String
  unitPriceCents Int       @map("unit_price_cents")
  quantity       Int

  @@index([orderId])
  @@map("food_order_lines")
}

/** Singleton facility config (id = "default"). */
model FacilitySettings {
  id                 String                  @id
  courtPricePesos    Int                     @map("court_price_pesos")
  openPlayPricePesos Int                     @map("open_play_price_pesos")
  clinicPricePesos   Int                     @map("clinic_price_pesos")
  openPlaySessions   Json                    @map("open_play_sessions")
  preSignup          Boolean                 @default(false) @map("pre_signup")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  paymentMethods     FacilityPaymentMethod[]

  @@map("facility_settings")
}

model FacilityPaymentMethod {
  id         String           @id @default(cuid())
  settingsId String           @map("settings_id")
  settings   FacilitySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  label      String
  name       String
  number     String
  qrImageKey String?          @map("qr_image_key")
  sortOrder  Int              @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([settingsId, sortOrder])
  @@map("facility_payment_methods")
}
