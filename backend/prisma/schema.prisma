generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id        String   @id @default(cuid())
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("examples")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  resource  String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
