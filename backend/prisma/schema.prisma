generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id        String   @id @default(cuid())
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("examples")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  resource  String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum WaitlistSource {
  join_club
  newsletter
  booking
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  name      String         @default("")
  email     String         @unique
  phone     String?
  source    WaitlistSource
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([email])
  @@map("waitlist_entries")
}

enum UserRole {
  student
  admin
}

/// Better Auth user (+ product role). Table kept as `users` for booking FKs.
model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  role          UserRole      @default(student)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  bookings      Booking[]
  wallet        Wallet?
  walletTopUps  WalletTopUp[]

  @@unique([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

enum BookingPlan {
  court
  open_play
  clinic
}

enum BookingStatus {
  pending
  approved
  rejected
}

model Booking {
  id              String        @id @default(cuid())
  plan            BookingPlan
  date            String
  courtId         String        @map("court_id")
  slotIds         String[]      @map("slot_ids")
  name            String
  email           String
  userId          String?       @map("user_id")
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  referenceId     String        @default("") @map("reference_id")
  receiptName     String?       @map("receipt_name")
  receiptKey      String?       @map("receipt_key")
  receiptMimeType String?       @map("receipt_mime_type")
  status          BookingStatus @default(pending)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([date, courtId])
  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([createdAt])
  @@map("bookings")
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0) @map("balance_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

enum WalletTopUpStatus {
  pending
  approved
  rejected
}

model WalletTopUp {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int               @map("amount_cents")
  receiptName     String?           @map("receipt_name")
  receiptKey      String?           @map("receipt_key")
  receiptMimeType String?           @map("receipt_mime_type")
  status          WalletTopUpStatus @default(pending)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("wallet_top_ups")
}
