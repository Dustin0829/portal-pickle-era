# --- Core (required for local dev) ---

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend?schema=public

# --- Core (sensible defaults) ---

API_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
OBSERVABILITY_SERVICE=backend

# --- Optional: Async SaaS Mode (BullMQ + worker) ---
# Leave REDIS_URL unset for Minimal SaaS Mode (CRUD without Redis).

# REDIS_URL=redis://localhost:6379
# Enables BullMQ producers, worker, and Bull Board at /admin/queues.

# --- Optional: Activity logs (Timescale) ---
# Unset = fail-open (product API still works; list returns 503).

# LOGS_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/backend_logs

# --- Optional: Admin tools basic auth (Swagger + Bull Board + /openapi.json) ---
# Required in production to expose /docs and /admin/queues.
# In development, admin tools are open when these are unset.

# ADMIN_BASIC_AUTH_USER=
# ADMIN_BASIC_AUTH_PASSWORD=

# --- Better Auth (session cookies for portals) ---
# Required in production. Local/dev falls back to a fixed secret if unset.
# BETTER_AUTH_SECRET=
# Public API origin (no trailing slash). Local default: http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000
# Production shared cookie domain (include leading dot), e.g. .pickleera.co
# AUTH_COOKIE_DOMAIN=.pickleera.co
# SPA must call APIs with credentials: 'include' and API_CORS_ORIGIN must list the exact web origin.

# --- Optional: S3-compatible object storage (Railway Bucket / any S3) ---
# Map Railway Bucket Credentials → these vars on the API service:
#   ENDPOINT → S3_ENDPOINT
#   ACCESS_KEY_ID → S3_ACCESS_KEY_ID
#   SECRET_ACCESS_KEY → S3_SECRET_ACCESS_KEY
#   BUCKET → S3_BUCKET
#   REGION → S3_REGION (usually auto)
# Unset = POST /uploads/presign and receipt-url fail with a config error (SPA soft-fails upload).

# S3_ENDPOINT=https://t3.storageapi.dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto

# Legacy R2 vars (unused by current storage adapter; prefer S3_* above)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# --- Optional: Discord API alerts ---

# DISCORD_API_ALERT_WEBHOOK_URL=
DISCORD_ALERT_SLOW_MS=5000

# --- Optional: Resend (player invite email on booking approve) ---
# Unset = approve still works; invite email is skipped and logged.
# EMAIL_FROM may be "Name <address@domain>" or a bare address.
# PUBLIC_APP_URL = SPA origin for login links (falls back to first API_CORS_ORIGIN).

# RESEND_API_KEY=
# EMAIL_FROM=Pickle Era <noreply@pickleera.co>
# PUBLIC_APP_URL=http://localhost:5173
